# ----------------------------
# Helpers
# ----------------------------

def have_gui() -> bool:
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def find_chromium() -> Optional[str]:
    for name in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "microsoft-edge"):
        path = shutil.which(name)
        if path:
            return path
    return None


def build_url(bind: str, port: int) -> str:
    host = bind
    if bind in ("0.0.0.0", "::"):
        host = "127.0.0.1"
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"http://{host}:{port}/viewer.html"


def emit_json_line(payload: dict) -> None:
    sys.stdout.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")
    sys.stdout.flush()


def read_cyjs_from_stdin() -> str:
    data = sys.stdin.read()
    if not data.strip():
        raise ValueError("No CYJS content received on stdin.")
    json.loads(data)
    return data


def read_cyjs_from_file(path: Path) -> str:
    data = path.read_text(encoding="utf-8")
    json.loads(data)
    return data


def parse_styles_json(text: str, src_path: Path) -> List[Dict[str, Any]]:
    obj = json.loads(text)
    if isinstance(obj, list):
        return obj
    if isinstance(obj, dict):
        for key in ("style", "styles"):
            v = obj.get(key)
            if isinstance(v, list):
                return v
    raise ValueError(f"Expected a JSON array, or an object with 'style'/'styles' array in {src_path}")


def load_style_file(path: Path) -> Tuple[bool, List[Dict[str, Any]]]:
    raw = path.read_text(encoding="utf-8")
    lines = raw.splitlines(True)
    if not lines:
        return (False, [])

    first = lines[0].lstrip()
    replace = first.startswith("# replace")

    if replace:
        rest = "".join(lines[1:]).strip()
        if not rest:
            return (True, [])
        return (True, parse_styles_json(rest, path))

    if not raw.strip():
        return (False, [])
    return (False, parse_styles_json(raw, path))


def scheme_to_filename(scheme: str) -> str:
    s = scheme.strip()
    if not s or s == "default":
        return "cyview.styles"
    return f"cyview.styles.{s}"


def resolve_styles_scheme(cli_value: Optional[str]) -> str:
    # Special sentinel: "list" handled by caller before normal flow.
    if cli_value is not None:
        return cli_value.strip() or "default"
    env = os.environ.get("CYVIEW_STYLES", "").strip()
    return env or "default"


def style_search_dirs(cyjs_source_file: Optional[Path], pwd: Path) -> List[Path]:
    dirs: List[Path] = [
        Path("/etc/cyview"),
        Path.home() / ".config" / "cyview",
    ]
    if cyjs_source_file is not None:
        dirs.append(cyjs_source_file.parent)
    dirs.append(pwd)
    # de-dupe while preserving order
    out: List[Path] = []
    seen: Set[str] = set()
    for d in dirs:
        try:
            d2 = d.resolve()
        except Exception:
            d2 = d
        k = str(d2)
        if k in seen:
            continue
        seen.add(k)
        out.append(d2)
    return out


def discover_style_schemes(cyjs_source_file: Optional[Path], pwd: Path) -> List[str]:
    """
    Discover available scheme names by scanning search dirs for:
      - cyview.styles           -> scheme "default"
      - cyview.styles.<name>    -> scheme "<name>"
    Returns sorted unique names, always including "default".
    """
    schemes: Set[str] = {"default"}
    for d in style_search_dirs(cyjs_source_file, pwd):
        if not d.exists() or not d.is_dir():
            continue
        # default
        if (d / "cyview.styles").is_file():
            schemes.add("default")
        # named schemes
        for p in d.glob("cyview.styles.*"):
            if not p.is_file():
                continue
            # scheme is suffix after "cyview.styles."
            name = p.name[len("cyview.styles."):]
            if name:
                schemes.add(name)
    return sorted(schemes)


def build_styles_collection(
    cyjs_source_file: Optional[Path],
    pwd: Path,
    scheme: str
) -> List[Dict[str, Any]]:
    styles: List[Dict[str, Any]] = list(DEFAULT_STYLES)
    stylesfile = scheme_to_filename(scheme)

    for folder in style_search_dirs(cyjs_source_file, pwd):
        sp = folder / stylesfile
        if not sp.exists() or not sp.is_file():
            continue
        try:
            replace, add_styles = load_style_file(sp)
            if replace:
                styles = []
            styles.extend(add_styles)
        except Exception as e:
            print(f"cyview: warning: ignoring invalid styles file {sp}: {e}", file=sys.stderr)

    return styles

# ----------------------------
# HTTP Handler with --once support
# ----------------------------

class OnceAwareHandler(SimpleHTTPRequestHandler):
    once_event: Optional[threading.Event] = None

    def log_message(self, format, *args):
        return

    def send_head(self):
        path_no_q = self.path.split("?", 1)[0]
        is_viewer = path_no_q in ("/viewer.html", "viewer.html")
        f = super().send_head()
        if is_viewer and f is not None and self.once_event is not None:
            self.once_event.set()
        return f


def make_server(docroot: Path, bind: str, port: int, once_event: Optional[threading.Event]) -> ThreadingHTTPServer:
    os.chdir(docroot)
    OnceAwareHandler.once_event = once_event
    return ThreadingHTTPServer((bind, port), OnceAwareHandler)


# ----------------------------
# Main
# ----------------------------

def main() -> int:
    ap = argparse.ArgumentParser(
        prog="cyview",
        description="Serve and view Cytoscape.js JSON graphs (.cyjs).",
        epilog="See `man cyview` for full documentation (including cyview.styles and --styles list).",
    )
    ap.add_argument(
        "input",
        nargs="?",
        default=None,
        help="Path to .cyjs file, or '-' to read from stdin. If omitted, reads stdin when piped.",
    )
    ap.add_argument(
        "--ui",
        choices=["auto", "chromium", "xdg-open", "print-url"],
        default="auto",
        help="UI mode: auto|chromium|xdg-open|print-url",
    )
    ap.add_argument(
        "--styles",
        default=None,
        metavar="NAME",
        help="Style scheme name (default: 'default'). Also configurable via $CYVIEW_STYLES. Use 'list' to show schemes.",
    )
    ap.add_argument("--bind", default="127.0.0.1", help="Bind address (default: 127.0.0.1).")
    ap.add_argument("--port", type=int, default=0, help="Port (default: 0 = auto).")
    ap.add_argument("--once", action="store_true", help="Exit after viewer page is first served (best-effort).")
    ap.add_argument("--emit", choices=["json"], default=None, help="Emit machine-readable info (currently: json).")
    ap.add_argument("--keep-alive", action="store_true", help="Don't auto-exit when chromium closes (debug).")

    args = ap.parse_args()

    # Decide input source early so we can discover schemes relative to file dir.
    piped = not sys.stdin.isatty()
    from_stdin = (args.input == "-") or (args.input is None and piped)

    cyjs_source_file: Optional[Path] = None
    if (not from_stdin) and args.input:
        cyjs_source_file = Path(args.input).expanduser().resolve()

    pwd = Path.cwd()

    # Tab-completion friendly mode: list schemes and exit.
    if args.styles is not None and args.styles.strip() == "list":
        for name in discover_style_schemes(cyjs_source_file=cyjs_source_file, pwd=pwd):
            print(name)
        return 0

    scheme = resolve_styles_scheme(args.styles)

    # Read CYJS
    try:
        if from_stdin:
            cyjs_text = read_cyjs_from_stdin()
            src_label = "stdin"
            cyjs_filename = "graph.cyjs"
        elif args.input:
            if cyjs_source_file is None:
                cyjs_source_file = Path(args.input).expanduser().resolve()
            cyjs_text = read_cyjs_from_file(cyjs_source_file)
            src_label = str(cyjs_source_file)
            cyjs_filename = cyjs_source_file.name
            if not cyjs_filename.lower().endswith(".cyjs"):
                cyjs_filename += ".cyjs"
        else:
            print("cyview: no input provided. Pass a .cyjs file, '-' for stdin, or pipe data into cyview.", file=sys.stderr)
            return 2
    except Exception as e:
        print(f"cyview: failed to read/parse CYJS: {e}", file=sys.stderr)
        return 2

    chromium = find_chromium()

    # Resolve UI selection
    if args.ui == "chromium":
        if not chromium:
            print("cyview: --ui chromium requested but chromium/chrome not found in PATH.", file=sys.stderr)
            return 3
        if not have_gui():
            print("cyview: --ui chromium requested but no GUI detected (DISPLAY/WAYLAND_DISPLAY unset).", file=sys.stderr)
            return 3
        ui_selected = "chromium"
    elif args.ui == "xdg-open":
        ui_selected = "xdg-open"
    elif args.ui == "print-url":
        ui_selected = "print-url"
    else:
        ui_selected = "chromium" if (chromium and have_gui()) else "xdg-open"

    styles = build_styles_collection(cyjs_source_file=cyjs_source_file, pwd=pwd, scheme=scheme)

    with tempfile.TemporaryDirectory(prefix="cyview-session-") as td:
        session_dir = Path(td)

        (session_dir / cyjs_filename).write_text(cyjs_text, encoding="utf-8")

        styles_json = json.dumps(styles, ensure_ascii=True)

        html = (
            HTML_TEMPLATE
            .replace("__CYJS_FILE__", cyjs_filename)
            .replace("__CYVIEW_STYLES_JSON__", styles_json)
        )

        (session_dir / "viewer.html").write_text(html, encoding="utf-8")

        once_event = threading.Event() if args.once else None

        try:
            httpd = make_server(session_dir, args.bind, args.port, once_event)
        except OSError as e:
            print(f"cyview: failed to bind server on {args.bind}:{args.port}: {e}", file=sys.stderr)
            return 2

        server_thread = threading.Thread(target=httpd.serve_forever, daemon=True)
        server_thread.start()

        actual_port = httpd.server_address[1]
        url = build_url(args.bind, actual_port)

        if args.emit == "json":
            emit_json_line({
                "url": url,
                "bind": args.bind,
                "port": actual_port,
                "ui": ui_selected,
                "source": src_label,
                "styles": scheme,
            })

        if ui_selected == "print-url":
            if args.emit != "json":
                print(url, flush=True)
            try:
                if once_event:
                    once_event.wait()
                else:
                    while True:
                        time.sleep(1)
            except KeyboardInterrupt:
                pass
            finally:
                httpd.shutdown()
                httpd.server_close()
            return 0

        if ui_selected == "chromium" and chromium:
            profile_dir = tempfile.mkdtemp(prefix="cyview-chromium-profile-")
            try:
                proc = subprocess.Popen(
                    [
                        chromium,
                        "--new-window",
                        f"--app={url}",
                        "--window-size=1400,900",
                        "--no-first-run",
                        "--no-default-browser-check",
                        "--disable-translate",
                        f"--user-data-dir={profile_dir}",
                    ],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                )

                time.sleep(0.6)
                rc = proc.poll()
                if rc is not None:
                    out, err = proc.communicate(timeout=2)
                    print("cyview: chromium exited immediately.", file=sys.stderr)
                    if err.strip():
                        print("chromium stderr:", file=sys.stderr)
                        print(err.rstrip(), file=sys.stderr)
                    if out.strip():
                        print("chromium stdout:", file=sys.stderr)
                        print(out.rstrip(), file=sys.stderr)

                    if args.emit != "json":
                        print(url, flush=True)
                    try:
                        if once_event:
                            once_event.wait()
                        else:
                            while True:
                                time.sleep(1)
                    except KeyboardInterrupt:
                        pass
                else:
                    if args.keep_alive:
                        if args.emit != "json":
                            print(f"cyview: serving {src_label} at {url} (Chromium PID {proc.pid})")
                        if once_event:
                            while True:
                                if proc.poll() is not None or once_event.is_set():
                                    break
                                time.sleep(0.2)
                        else:
                            proc.wait()
                    else:
                        if once_event:
                            while True:
                                if proc.poll() is not None or once_event.is_set():
                                    break
                                time.sleep(0.2)
                        else:
                            proc.wait()
            finally:
                shutil.rmtree(profile_dir, ignore_errors=True)
                httpd.shutdown()
                httpd.server_close()
            return 0

        subprocess.run(["xdg-open", url], check=False)
        try:
            if once_event:
                once_event.wait()
            else:
                while True:
                    time.sleep(1)
        except KeyboardInterrupt:
            pass
        finally:
            httpd.shutdown()
            httpd.server_close()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
